{
 "statement": "SYNTHETIC procedural terrain. Not derived from, fitted to, or validated against any real aerial image. Results on it say nothing certain about real imagery.",
 "seed": 2027,
 "size_m": 1600.0,
 "res_m": 0.5,
 "parameters": [
  {
   "parameter": "tramline spacing",
   "value": "24 m and 36 m dominant; 12, 18, 30 m also drawn",
   "basis": "source + assumed",
   "reference": "profi.co.uk says UK tramline widths are mostly 24 m or 36 m (https://profi.co.uk/test-centre/spreading-granular-fertiliser-wider-spread-wide-gain-acres). The 12/18/30 m values and all the weights are assumed."
  },
  {
   "parameter": "tramline wheel gauge",
   "value": "1.8 to 2.0 m",
   "basis": "source",
   "reference": "Hardi Alpha Varitrack track width adjustable from 1.80 m to 2.25 m (https://www.fwi.co.uk/machinery/hardi-launches-a-smaller-alpha-self-propelled-with-stepless-track-width-adjustment); the brief gives 1.8 to 2 m."
  },
  {
   "parameter": "wheel-track width",
   "value": "about 0.45 m (Gaussian, sigma 0.19 m)",
   "basis": "assumed",
   "reference": "The same article quotes 270 mm row-crop tyres; the visible rut is assumed wider."
  },
  {
   "parameter": "tramline contrast",
   "value": "median 22 grey levels (42 in the tramline style), 80 % darker than crop",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "tramline headland",
   "value": "one circuit half a spacing inside the boundary",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "hedge width",
   "value": "median 2.0 m (2.5 m pasture), log-normal sd 0.3",
   "basis": "source + assumed",
   "reference": "Countryside Survey 2000: about 68 % of hedges 1 to 2 m wide (https://nora.nerc.ac.uk/id/eprint/4798/1/M03_hedgerows_final_report.pdf). Spread assumed."
  },
  {
   "parameter": "hedge height",
   "value": "median 2.2 m (2.6 m pasture), log-normal sd 0.3",
   "basis": "source + assumed",
   "reference": "UKCEH/Natural England 2007-2023 comparison: most hedges now taller than 2 m (reported via https://hedgelink.org.uk/?p=5058). Spread assumed."
  },
  {
   "parameter": "hedge gaps",
   "value": "about 10 % of hedge length missing, plus gateways every ~220 m",
   "basis": "source + assumed",
   "reference": "Countryside Survey 2000: gaps very rarely exceed 10 % of length (https://nora.nerc.ac.uk/id/eprint/4798/1/M03_hedgerows_final_report.pdf). The open and tramline styles deliberately use gappier hedges. Gateway spacing and the gappy-run model are assumed."
  },
  {
   "parameter": "boundary trees",
   "value": "0.4 to 2.2 per 100 m of hedge, crown diameter 4 to 12 m, height 9 to 19 m",
   "basis": "assumed",
   "reference": "Crown range from the brief; no density source found."
  },
  {
   "parameter": "field area",
   "value": "median 9 ha arable, 4 ha mixed, 2 ha pasture, 30 ha open, 10 ha tramline",
   "basis": "assumed",
   "reference": "No published mean field size found. Crude anchor (derived, not sourced): about 2.6 million RPA land parcels in England (https://www.data.gov.uk/dataset/ed6f8d0e-df4f-4027-b4e3-ee43d7cebf35/rpa-parcel-points-england) over roughly 9 million ha of farmland gives about 3.5 ha per parcel. Regional contrast is supported only qualitatively: East of England is 80 % arable, the west mostly pasture (https://www.gov.uk/government/statistics/agricultural-facts-england-regional-profiles/agricultural-facts-summary)."
  },
  {
   "parameter": "field shape",
   "value": "convex, almost all 4-sided, split jitter 4 to 10 deg, boundary warp 3 to 7 m",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "boundary type mix",
   "value": "hedge / fence-or-ditch margin / bare crop line, per style",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "road and track width",
   "value": "lane 3.2 to 5.5 m, track 2.4 to 3.6 m, verge 1 to 2.5 m",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "buildings",
   "value": "12-32 m by 8-18 m, eaves 4-6.5 m, ridge +1.5-3 m, yard 50-75 m by 38-50 m",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "woods and ponds",
   "value": "copse radius 15-45 m, canopy about 14 m; pond radius 5-16 m",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "grey levels",
   "value": "fields 92-172 by cover, hedge 58, tree 55, wood 52, road 120, track 168 or 88, roof 185 or 75, yard 150, water 32, verge 108",
   "basis": "assumed",
   "reference": "No orthophoto radiometry source found. These are guesses on a 0..255 scale."
  },
  {
   "parameter": "within-field variation",
   "value": "patches sd 6 at 18 and 60 m scales, per-pixel texture sd 3.5, drill stripes sd 1.5",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "shadow depth",
   "value": "55 % darkening in full shadow, 0.5 m soft edge",
   "basis": "assumed",
   "reference": ""
  },
  {
   "parameter": "sun positions",
   "value": "map (180, 55) deg, flight (150, 35) deg",
   "basis": "assumed",
   "reference": "Defaults from the brief."
  }
 ],
 "limitations": [
  "Fields are convex pieces of a recursive straight-line subdivision; real fields include concave shapes, curved ancient boundaries and streams.",
  "The ground is flat: height holds only hedges, trees and buildings, so there is no relief, no relief shadow and no parallax from terrain.",
  "Grey levels and contrasts are assumptions, not measured from orthophotos.",
  "Field level, tramline presence and land use are drawn independently; real pasture stays pasture and has no tramlines.",
  "A changed field keeps the same permanent soil-patch pattern (rescaled).",
  "Shadows are cast only by objects inside the raster and are a fixed fractional darkening; there is no sky-light model and no cloud shadow.",
  "Fine texture is per pixel, so its scale follows res_m.",
  "No villages, rivers, railways, pylons, livestock, vehicles or bales."
 ],
