	)
	(text "OPTIONAL COMPASS DAUGHTERBOARD"
		(exclude_from_sim no)
		(at 322.58 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2f54a808-86a2-44c8-90f6-c5c68d400dd4")
	)
	(text "R26 at MCU PB13; AUX_SCK feeds flash and RF.\nR27 CS default; R28/R29 keep WP/HOLD inactive.\nC40/C41 U11 supply; wide-body 208 mil SOIC.\nRF ribbon: begin SPI testing at ~1 MHz."
		(exclude_from_sim no)
		(at 20.32 214.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "32799b32-4b57-41d5-9961-f1d59d6cfe60")
	)
	(text "J5 DNP by default.\nI2C1 shared with barometer.\nUse existing MAIN I2C pull-ups.\nCompass electronics live on the daughterboard."
		(exclude_from_sim no)
		(at 322.58 198.12 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "54f40431-c736-4812-87cc-b23fb921c300")
	)
	(text "J4: keyed 2.54 mm 20-way IDC ribbon.\nRF end uses the identical contact numbers.\nMark pin 1 at both ends; check cable continuity.\nOnly 3.3 V crosses to RF; no Pi 5 V."
		(exclude_from_sim no)
		(at 210.82 214.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "586f75b5-3785-4b2c-bef3-3fb9e2397c19")
	)
	(text "STATUS / FAULT INDICATORS"
		(exclude_from_sim no)
		(at 322.58 212.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5b7043a9-8daa-4bbd-966e-63c1d7314be8")
	)
	(text "R35 gate series, R36 default OFF; D3 flyback. C43/C44 sounder supply.\nDrive at 4 kHz. Check loudness at 3.3 V; 100 dB rating is at 5 V."
		(exclude_from_sim no)
		(at 105.41 280.67 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left)
		)
		(uuid "74d5e180-f174-4a5f-aa42-1f0e11cfb3be")
	)
	(text "CAMERA XTR TRIGGER"
		(exclude_from_sim no)
		(at 320.04 35.56 0)
