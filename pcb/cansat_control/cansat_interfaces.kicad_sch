	(text "R37/D4 status; R38/D5 fault.\nMCU drives high to illuminate (~4 mA)."
		(exclude_from_sim no)
		(at 345.44 232.41 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "9e9ca31e-0aea-4f93-94e5-4876249a151b")
	)
	(text "J2 -> Pi Zero 2 W:\n1/3/5: 5 V, parallel harness contacts\n2/4/6: GND, parallel returns\n7: Pi pin 10 / GPIO15 RXD\n8: Pi pin 8 / GPIO14 TXD\nPi 3.3 V is separate.\nGH contacts: 1 A per contact."
		(exclude_from_sim no)
		(at 266.7 66.04 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "9f84d37d-2223-4f78-9a22-c031d8162167")
	)
	(text "R33/R34: 3.3 V -> nominal 1.8 V trigger.\nJ3: 1 XTR, 2/3 GND, 4 NC. CSI cable goes directly to Pi.\nPB0 low / Hi-Z while Pi is off; high idle when powered.\nCamera revision may require R11 removal; see guide."
		(exclude_from_sim no)
		(at 310.515 107.95 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "bf46852e-e781-4694-a0e2-ba9d18a1d0a3")
	)
