	(text "R30 disables both paths during MCU reset.\nR31 pulls Pi TX low while Pi is off; R32 keeps MCU RX idle high.\nC42 is U10 bypass. Enable buffers only after Pi power is stable."
		(exclude_from_sim no)
		(at 20.32 124.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "1e22e2d9-adc7-4d38-afa3-df95dc9100b9")
	)
	(text "J4 MAIN -> RF RIBBON LINK"
		(exclude_from_sim no)
		(at 210.82 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "24416641-a0f1-4737-815f-3c8b2bd73b42")
	)
	(text "INDEPENDENT RECOVERY SOUNDER"
